<style>
    body {
        min-height: 100vh;
        background: linear-gradient(135deg, #eb6864 0%, #764ba2 100%);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .glassmorphism-navbar {
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px 0 rgba(135, 45, 31, 0.37);
        border-radius: 0;
        transition: all 0.3s ease;
    }

    .glassmorphism-navbar .navbar-brand {
        font-weight: 600;
        font-size: 1.25rem;
        transition: all 0.3s ease;
    }

    .glassmorphism-navbar .navbar-brand:hover {
        transform: translateY(-1px);
    }

    .glassmorphism-navbar .navbar-nav .nav-link {
        font-weight: 500;
        padding: 0.75rem 1rem !important;
        border-radius: 8px;
        margin: 0 0.25rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .glassmorphism-navbar .navbar-nav .nav-link:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    .glassmorphism-navbar .navbar-nav .nav-link.active {
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .glassmorphism-navbar .navbar-toggler {
        border: none;
        padding: 0.5rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .glassmorphism-navbar .navbar-toggler:focus {
        box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.25);
    }

    .glassmorphism-navbar .navbar-toggler:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .dropdown-menu {
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
        border-radius: 12px;
        padding: 0.5rem;
    }

    .dropdown-item {
        color: rgba(255, 255, 255, 0.85);
        border-radius: 8px;
        margin: 0.25rem 0;
        transition: all 0.3s ease;
    }

    .dropdown-item:hover {
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 1);
        transform: translateX(5px);
    }

    /* Animation au scroll */
    .navbar-scrolled {
        background: rgba(255, 255, 255, 0.15) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 12px 40px 0 rgba(135, 31, 31, 0.5);
    }
</style>

<script>
  // Animation au scroll
  window.addEventListener('scroll', function() {
    const navbar = document.querySelector('.glassmorphism-navbar');
    if (window.scrollY > 50) {
      navbar.classList.add('navbar-scrolled');
    } else {
      navbar.classList.remove('navbar-scrolled');
    }
  });
</script>


<nav class=" navbar navbar-expand-lg fixed-top glassmorphism-navbar">
  <div class="container">
    <a class="navbar-brand fw-bold" href="#">SCI-Facile <i class="fas fa-building me-2"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/">Accueil</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/#fonctionnalites">Fonctionnalités</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/#tarif">Tarif</a>
        </li>
        <% if associate_signed_in? %>
          <li class="nav-item ms-2">
            <%= link_to current_associate.email, company_associate_path(current_associate.company, current_associate), class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to destroy_associate_session_path, data: { turbo_method: "delete" }, class: "nav-link", title: "Déconnexion" do %>
              <i class="fas fa-sign-out-alt"></i>
            <% end %>
          </li>
        <% else %>
          <li class="nav-item ms-2">
            <%= link_to "Connexion", new_session_path(:associate), class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>